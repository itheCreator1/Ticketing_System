<!--
  Audit Log Tab Navigation

  Required Parameters:
  - activeTab: string - 'explorer' or 'timeline'

  Optional Parameters:
  - timelineUser: object - User object for timeline tab label { username }
-->

<%
  const isExplorer = activeTab === 'explorer';
  const isTimeline = activeTab === 'timeline';
  const timelineUsername = typeof timelineUser !== 'undefined' && timelineUser ? timelineUser.username : null;
%>

<div class="flex border-b border-gray-200 mb-6">
  <a href="/admin/audit-logs"
     class="px-4 py-2 -mb-px text-sm font-medium border-b-2 transition-colors
       <%= isExplorer ? 'border-blue-500 text-blue-600' : 'border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300' %>">
    <i class="bi bi-journal-text mr-1"></i> <%= t('audit:logExplorer') %>
  </a>
  <% if (timelineUsername) { %>
    <span class="px-4 py-2 -mb-px text-sm font-medium border-b-2 transition-colors
      <%= isTimeline ? 'border-blue-500 text-blue-600' : 'border-transparent text-gray-500' %>">
      <i class="bi bi-clock-history mr-1"></i> <%= t('audit:userTimeline') %>: <%= timelineUsername %>
    </span>
  <% } %>
</div>
